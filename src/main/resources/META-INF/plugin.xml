<idea-plugin version="2" url="https://logtime.com" require-restart="true">
    <id>uk.co.sangharsh.logtime.plugin</id>
    <name>WakaTime</name>
    <version>16.1.2</version>
    <vendor email="support@logtime.com" url="https://logtime.com">WakaTime</vendor>

    <description><![CDATA[
      Metrics, insights, and time tracking automatically generated from your programming activity.<br />
      <br />
      <b>Installation</b><br />
      <br />
      1. Inside your IDE, select Preferences -> Plugins -> Browse Repositories....<br />
      <br />
      2. Search for wakatime.<br />
      <br />
      3. Click the green Install Plugin button and confirm the installation.<br />
      <br />
      4. Re-launch your IDE.<br />
      <br />
      5. Enter your <a href="https://logtime.com/settings/account?apikey=true">api key</a>, then click Save.<br />
      <br />
      6. Use your IDE like you normally do and your time will be tracked for you automatically.<br />
      <br />
      7. Visit https://logtime.com to see your logged time.<br />
      <br />
      Source Code:  <a href="https://github.com/wakatime/jetbrains-wakatime">https://github.com/wakatime/jetbrains-wakatime</a>
    ]]></description>


    <!-- please see http://confluence.jetbrains.com/display/IDEADEV/Build+Number+Ranges for description -->
    <idea-version since-build="2026"/>

    <!-- please see http://confluence.jetbrains.com/display/IDEADEV/Plugin+Compatibility+with+IntelliJ+Platform+Products
         on how to target different products -->
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.platform</depends>
    <!-- <depends optional="true" config-file="uk.co.sangharsh.logtime.plugin-java.xml">com.intellij.modules.java</depends> -->

    <extensions defaultExtensionNs="com.intellij">
        <statusBarWidgetFactory implementation="uk.co.sangharsh.logtime.plugin.CustomStatusBar"
                                id="uk.co.sangharsh.logtime.plugin.CustomStatusBar"
                                order="first" />
        <postStartupActivity implementation="uk.co.sangharsh.logtime.plugin.LogTimeStartupActivity" />
    </extensions>

    <application-components>
        <component>
            <implementation-class>uk.co.sangharsh.logtime.plugin.LogTime</implementation-class>
        </component>
    </application-components>

    <actions>
        <action id="pluginMenu" class="uk.co.sangharsh.logtime.plugin.PluginMenu" text="WakaTime">
            <add-to-group group-id="ToolsMenu" anchor="first" />
        </action>
    </actions>

</idea-plugin>
